<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:clipToPadding="false"
        android:clipChildren="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            style="@style/HeaderRow">

            <ImageView
                android:id="@+id/btn_back"
                android:src="@drawable/ic_back"
                style="@style/HeaderBackIcon"
                android:layout_marginEnd="12dp"
                />

            <TextView
                android:id="@+id/reports_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reports"
                android:includeFontPadding="false"
                style="@style/HeaderTitle"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/neutral_dark_gray"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="@string/report_filters"
                style="@style/SectionTitle"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/neutral_dark_gray"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_date_from"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_date_from"
            android:gravity="left|center_vertical"
            app:icon="@drawable/ic_calendar"
            app:iconGravity="end"
            style="@style/InputField"
            app:backgroundTint="@null"
            android:textColor="@color/text_primary"
            app:iconTint="@color/text_primary"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_date_to"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_date_to"
            android:gravity="left|center_vertical"
            app:icon="@drawable/ic_calendar"
            app:iconGravity="end"
            style="@style/InputField"
            app:backgroundTint="@null"
            android:textColor="@color/text_primary"
            app:iconTint="@color/text_primary"
            />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_scope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/report_scope"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:visibility="gone"
            app:endIconMode="dropdown_menu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/et_scope"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="@dimen/text_regular"
                style="@style/InputBoxDropdownText"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_user_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/report_user_email"
            style="@style/InputBoxLayout"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_user_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:textSize="@dimen/text_regular"
                style="@style/InputBoxEditText" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_generate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:text="@string/report_generate"
            android:textAllCaps="false"
            style="@style/BtnFilled" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/neutral_dark_gray"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="@string/report_summary"
                style="@style/SectionTitle"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/neutral_dark_gray"/>
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingBottom="6dp"
            android:clipToPadding="false"
            android:clipChildren="false">

            <LinearLayout
                android:id="@+id/card_total_rides"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_report_stat_card"
                android:padding="14dp"
                android:orientation="vertical"
                android:gravity="center"
                android:elevation="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/card_total_distance"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintDimensionRatio="5:4"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/summary_total_rides_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="28sp"
                    android:textColor="@color/primary_dark"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_medium"
                    android:textAlignment="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/report_total_rides"
                    style="@style/SectionTitle"
                    android:textColor="@color/text_secondary"
                    android:textAlignment="center"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_total_distance"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_report_stat_card"
                android:padding="14dp"
                android:orientation="vertical"
                android:gravity="center"
                android:elevation="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/card_total_rides"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintDimensionRatio="5:4"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/summary_total_distance_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="28sp"
                    android:textColor="@color/primary_dark"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_medium"
                    android:textAlignment="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/report_total_distance"
                    style="@style/SectionTitle"
                    android:textColor="@color/text_secondary"
                    android:textAlignment="center"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingBottom="6dp"
            android:clipToPadding="false"
            android:clipChildren="false">

            <LinearLayout
                android:id="@+id/card_total_money"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_report_stat_card"
                android:padding="14dp"
                android:orientation="vertical"
                android:gravity="center"
                android:elevation="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/card_avg_rides"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintDimensionRatio="5:4"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/summary_total_money_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="28sp"
                    android:textColor="@color/primary_dark"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_medium"
                    android:textAlignment="center" />

                <TextView
                    android:id="@+id/summary_total_money_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/poppins_regular"
                    android:textAlignment="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/report_total_money"
                    style="@style/SectionTitle"
                    android:textColor="@color/text_secondary"
                    android:textAlignment="center"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_avg_rides"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_report_stat_card"
                android:padding="14dp"
                android:orientation="vertical"
                android:gravity="center"
                android:elevation="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/card_total_money"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintDimensionRatio="5:4"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/summary_avg_rides_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="28sp"
                    android:textColor="@color/primary_dark"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_medium"
                    android:textAlignment="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/report_avg_rides"
                    style="@style/SectionTitle"
                    android:textColor="@color/text_secondary"
                    android:textAlignment="center"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingBottom="6dp"
            android:clipToPadding="false"
            android:clipChildren="false">

            <LinearLayout
                android:id="@+id/card_avg_distance"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_report_stat_card"
                android:padding="14dp"
                android:orientation="vertical"
                android:gravity="center"
                android:elevation="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/card_avg_money"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintDimensionRatio="5:4"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/summary_avg_distance_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="28sp"
                    android:textColor="@color/primary_dark"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_medium"
                    android:textAlignment="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/report_avg_distance"
                    style="@style/SectionTitle"
                    android:textColor="@color/text_secondary"
                    android:textAlignment="center"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_avg_money"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_report_stat_card"
                android:padding="14dp"
                android:orientation="vertical"
                android:gravity="center"
                android:elevation="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/card_avg_distance"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintDimensionRatio="5:4"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/summary_avg_money_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="28sp"
                    android:textColor="@color/primary_dark"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_medium"
                    android:textAlignment="center" />

                <TextView
                    android:id="@+id/summary_avg_money_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/poppins_regular"
                    android:textAlignment="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/report_avg_money"
                    style="@style/SectionTitle"
                    android:textColor="@color/text_secondary"
                    android:textAlignment="center"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/neutral_dark_gray"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="@string/report_daily_charts"
                style="@style/SectionTitle"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/neutral_dark_gray"/>
        </LinearLayout>

        <TextView
            android:id="@+id/no_daily_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_no_daily_data"
            android:textColor="@color/neutral_dark_gray"
            android:visibility="gone"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:fontFamily="@font/poppins_regular" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_chart_rides"
            android:layout_marginTop="6dp"
            android:layout_marginStart="8dp"
            style="@style/SectionTitle"/>

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chart_rides"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_chart_distance"
            android:layout_marginStart="8dp"
            style="@style/SectionTitle"/>

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chart_distance"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_chart_money"
            android:layout_marginStart="8dp"
            style="@style/SectionTitle"/>

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chart_money"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</ScrollView>
