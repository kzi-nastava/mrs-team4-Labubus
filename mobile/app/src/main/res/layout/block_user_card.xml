<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/block_user_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_user_card"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:id="@+id/block_user_main_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/block_user_texts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/block_user_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Full Name · Role"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_medium"/>

            <TextView
                android:id="@+id/block_user_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="email@example.com"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_regular"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/block_user_inline_action"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:minWidth="96dp"
            android:backgroundTint="@color/error"
            android:text="Block"
            android:textAllCaps="false"
            android:textColor="@color/surface"
            android:fontFamily="@font/poppins_medium"
            android:textSize="15sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/error"
            app:strokeWidth="1dp"/>
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/block_user_note_layout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Note (optional)"
        android:visibility="gone"
        app:boxBackgroundColor="@color/surface"
        app:boxStrokeColor="@color/primary_light"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:hintTextColor="@color/text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/block_user_note_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/block_user_secondary"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/primary"
        android:text="@string/cancel"
        android:textAllCaps="false"
        android:textColor="@color/surface"
        android:fontFamily="@font/poppins_medium"
        android:textSize="15sp"
        app:cornerRadius="10dp"
        android:visibility="gone"
        app:strokeColor="@color/primary_dark"
        app:strokeWidth="1dp"/>
</LinearLayout>
