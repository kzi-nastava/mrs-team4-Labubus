<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <org.osmdroid.views.MapView
            android:id="@+id/map"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:background="@color/surface"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


        <ImageButton
            android:id="@+id/btn_menu"
            android:src="@drawable/ic_menu"
            style="@style/IconButtonWhite"
            android:layout_marginTop="32dp"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

        <ImageButton
            android:id="@+id/btn_map_search"
            android:src="@drawable/ic_map_search"
            style="@style/IconButtonWhite"
            android:layout_marginTop="32dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_menu"
            />
        <LinearLayout
            android:id="@+id/block_notice"
            android:layout_width="0dp"
            android:layout_height="@dimen/icon_regular"
            android:layout_marginStart="8dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_block_notice"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/btn_map_search"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/block_notice_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="You have been blocked"
                android:textColor="@color/surface"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_medium"
                android:textStyle="bold"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/block_notice_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="There is no reason provided"
                android:textColor="@color/surface"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_complaint"
            android:src="@drawable/ic_complaint"
            style="@style/IconButtonWhite"
            android:foreground="@null"
            android:elevation="0dp"
            android:stateListAnimator="@animator/press_lift"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@id/btn_chat"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <!-- chat menu icon bottom right -->
        <ImageButton
            android:id="@+id/btn_chat"
            android:src="@drawable/ic_chat"
            style="@style/IconButtonWhite"
            android:foreground="@null"
            android:elevation="0dp"
            android:stateListAnimator="@animator/press_lift"
            android:layout_marginBottom="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />


        <ImageButton
            android:id="@+id/btn_panic"
            android:layout_width="@dimen/icon_regular"
            android:layout_height="@dimen/icon_regular"
            android:src="@drawable/ic_warning_surface"
            style="@style/IconButtonWhite"
            android:background="@drawable/btn_panic"
            android:foreground="@null"
            android:elevation="0dp"
            android:stateListAnimator="@animator/press_lift"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:enabled="false"
            android:alpha="0.5"/>

        <ImageButton
            android:id="@+id/btn_cancel_driver"
            android:layout_width="@dimen/icon_regular"
            android:layout_height="@dimen/icon_regular"
            android:src="@drawable/ic_cancel"
            style="@style/IconButtonWhite"
            android:background="@drawable/btn_cancel"
            android:foreground="@null"
            android:elevation="0dp"
            android:stateListAnimator="@animator/press_lift"
            android:layout_marginBottom="8dp"
            app:layout_constraintStart_toStartOf="@id/btn_panic"
            app:layout_constraintBottom_toTopOf="@id/btn_panic"
            android:enabled="false"
            android:alpha="0.5"
            />

            <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_ride"
            android:layout_width="0dp"
            android:layout_height="@dimen/icon_regular"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="8dp"
            android:text="Start this ride"
            android:enabled="false"
            android:alpha="0.5"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:fontFamily="@font/poppins_medium"
            android:textSize="@dimen/text_regular"
            android:elevation="0dp"
            android:stateListAnimator="@animator/press_lift"
            app:rippleColor="@android:color/white"
            android:background="@drawable/btn_start_ride"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_panic"
            app:layout_constraintEnd_toStartOf="@id/btn_chat" />

        <ProgressBar
            android:id="@+id/route_loading_spinner"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/surface"
            android:visibility="gone"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <FrameLayout
            android:id="@+id/modal_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:background="#00000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <include
            android:id="@+id/ride_order_sheet"
            layout="@layout/ride_order_sheet"/>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:layout_gravity="start"
        app:itemIconTint="@null"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="20dp"
        app:headerLayout="@layout/nav_header_account"
        app:itemTextAppearance="@style/DrawerTextAppearance"
      />

</androidx.drawerlayout.widget.DrawerLayout>

