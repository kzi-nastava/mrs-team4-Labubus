<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <org.osmdroid.views.MapView
        android:id="@+id/ride_details_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:id="@+id/ride_details_bottom_drawer"
        android:layout_width="match_parent"
        android:layout_height="520dp"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet_rounded"
        android:padding="16dp"
        app:layout_behavior="@string/bottom_sheet_behavior">

        <LinearLayout
            android:id="@+id/ride_details_handle"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:gravity="center">

            <View
                android:id="@+id/ride_details_handle_bar"
                android:layout_width="80dp"
                android:layout_height="6dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/surface"/>
        </LinearLayout>

        <TextView
            android:id="@+id/ride_details_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/ride_details_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/ride_details_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="30dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_clock_primary"
                        android:layout_marginRight="10dp"/>

                    <TextView
                        android:id="@+id/ride_details_start"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:textSize="16dp"
                        android:text="25 Dec 2025 00:00"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_dots"
                        android:layout_marginRight="10dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:text=""
                        android:background="#D5D5D5"
                        android:layout_marginRight="30dp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="15dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_clock_primary"
                        android:layout_marginRight="10dp"/>

                    <TextView
                        android:id="@+id/ride_details_end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:textSize="16dp"
                        android:text="25 Dec 2025 00:00"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ride_details_waypoints"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="15dp">



                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ride_details_distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:textSize="@dimen/text_regular"
                        android:textColor="@color/text_primary"
                        android:text="3.4km"
                        android:layout_gravity="center_vertical"
                        android:layout_marginRight="5dp"
                        android:includeFontPadding="false"/>

                    <LinearLayout
                        android:id="@+id/ride_details_markers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ride_details_passenger_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_regular"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/text_primary"
                        android:text="Passengers"
                        android:layout_marginTop="15dp"/>

                    <LinearLayout
                        android:id="@+id/ride_details_passengers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ride_details_driver_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_regular"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/text_primary"
                        android:text="Driver"
                        android:layout_marginTop="15dp"/>

                    <LinearLayout
                        android:id="@+id/ride_details_driver"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ride_details_vehicle_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_regular"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/text_primary"
                        android:text="Vehicle"
                        android:layout_marginTop="15dp"/>

                    <LinearLayout
                        android:id="@+id/ride_details_vehicle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ride_details_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <Button
                    android:id="@+id/ride_details_reorder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/BtnFilled"
                    android:padding="6dp"
                    android:text="@string/reorder"
                    android:layout_marginTop="15dp"/>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
